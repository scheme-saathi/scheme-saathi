{
  "scheme_id": "M12",
  "name": "Ramai Awas (Gharkul) Scheme for SC & Nav-Buddha (Urban and Rural)",
  "level": "state",
  "state": "Maharashtra",
  "source": {
    "url": "https://www.myscheme.gov.in/schemes/rassnb",
    "collected_on": "2026-10-28"
  },
  "clauses": [
    {
      "clause_id": "elig-1",
      "text": "1. The applicant should have lived for 15 years in Maharashtra."
    },
    {
      "clause_id": "elig-3",
      "text": "For Rural Area, ₹1,00,000/- per annum."
    },
    {
      "clause_id": "elig-4",
      "text": "For Municipal Area, ₹1,50,000/- per annum."
    },
    {
      "clause_id": "elig-5",
      "text": "For Municipal Corporation, ₹2,00,000/- per annum."
    },
    {
      "clause_id": "elig-6",
      "text": "3. Only one person in the family will get the benefit."
    },
    {
      "clause_id": "elig-7",
      "text": "4. The applicant should have his/her own land"
    },
    {
      "clause_id": "elig-8",
      "text": "5. The applicant should not be receiving the benefits of any other housing scheme of the Government."
    },
    {
      "clause_id": "elig-10",
      "text": "Priority will be given to applicants from the Below Poverty Line (BPL)."
    },
    {
      "clause_id": "details-1",
      "text": "The scheme \"Ramai Awas (Gharkul) Scheme for SC & Nav-Buddha (Urban and Rural)\" is a housing scheme by the Department of Social Justice & Special Assistance of the Government of Maharashtra. The scheme aims to raise the standard of living of the individuals from the Scheduled Caste and Nav-Buddha communities residing in rural & urban areas of Maharashtra."
    }
  ],
  "documents_required": [
    "Residential / Domicile Certificate.",
    "Caste Certificate.",
    "Aadhaar Card",
    "Address Proof.",
    "Identity Card.",
    "Passport Size Photo."
  ],
  "rules": [
    {
      "field": "years_resident_in_maharashtra",
      "op": "gte",
      "value": 15,
      "clause_id": "elig-1",
      "status": "draft"
    },
    {
      "field": "social_category",
      "op": "in",
      "value": [
        "SC",
        "Nav-Buddha"
      ],
      "clause_id": "details-1",
      "status": "draft"
    },
    {
      "field": "residence_area_type",
      "op": "ne",
      "value": "rural",
      "clause_id": "elig-3",
      "status": "draft",
      "or_conditions": [
        {
          "field": "annual_family_income",
          "op": "lte",
          "value": 100000
        }
      ]
    },
    {
      "field": "residence_area_type",
      "op": "ne",
      "value": "municipal council",
      "clause_id": "elig-4",
      "status": "draft",
      "or_conditions": [
        {
          "field": "annual_family_income",
          "op": "lte",
          "value": 150000
        }
      ]
    },
    {
      "field": "annual_family_income",
      "op": "lte",
      "value": 200000,
      "clause_id": "elig-5",
      "status": "draft"
    },
    {
      "field": "family_member_already_got_ramai_awas",
      "op": "eq",
      "value": false,
      "clause_id": "elig-6",
      "status": "draft"
    },
    {
      "field": "owns_land_for_house",
      "op": "eq",
      "value": true,
      "clause_id": "elig-7",
      "status": "draft"
    },
    {
      "field": "receives_other_government_housing_benefit",
      "op": "eq",
      "value": false,
      "clause_id": "elig-8",
      "status": "draft"
    }
  ],
  "rule_logic": "all"
}
