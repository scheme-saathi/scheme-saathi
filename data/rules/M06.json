{
  "scheme_id": "M06",
  "name": "Homes For Intellectually Impaired Persons",
  "level": "state",
  "state": "Maharashtra",
  "source": {
    "url": "https://www.myscheme.gov.in/schemes/hiip",
    "collected_on": "2026-10-28"
  },
  "clauses": [
    {
      "clause_id": "elig-1",
      "text": "The applicant should be a citizen of India."
    },
    {
      "clause_id": "elig-2",
      "text": "The applicant should be an orphan."
    },
    {
      "clause_id": "elig-3",
      "text": "The applicant should be a permanent resident of Maharashtra State."
    },
    {
      "clause_id": "elig-4",
      "text": "The applicant should be a Mentally Deficient Child (MDC) who is in need of care and protection."
    },
    {
      "clause_id": "elig-5",
      "text": "The percentage of the disability should be 40% or above."
    }
  ],
  "documents_required": [
    "Aadhaar Card.",
    "2-Passport Sized Photograph (Signed Across).",
    "Proof of Age (Birth Certificate, etc).",
    "Residential Certificate / Domicile Certificate of the State of Maharashtra.",
    "Disability Certificate.",
    "Details of the Bank Account (Bank Name, Branch Name, Address, IFSC, etc).",
    "Any other document required by the Child Welfare Committee."
  ],
  "rules": [
    {
      "field": "is_indian_citizen",
      "op": "eq",
      "value": true,
      "clause_id": "elig-1",
      "status": "draft"
    },
    {
      "field": "is_orphan",
      "op": "eq",
      "value": true,
      "clause_id": "elig-2",
      "status": "draft"
    },
    {
      "field": "is_maharashtra_resident",
      "op": "eq",
      "value": true,
      "clause_id": "elig-3",
      "status": "draft"
    },
    {
      "field": "age",
      "op": "lt",
      "value": 18,
      "clause_id": "elig-4",
      "status": "draft"
    },
    {
      "field": "has_intellectual_disability",
      "op": "eq",
      "value": true,
      "clause_id": "elig-4",
      "status": "draft"
    },
    {
      "field": "needs_care_and_protection",
      "op": "eq",
      "value": true,
      "clause_id": "elig-4",
      "status": "draft"
    },
    {
      "field": "disability_percent",
      "op": "gte",
      "value": 40,
      "clause_id": "elig-5",
      "status": "draft"
    }
  ],
  "rule_logic": "all"
}
