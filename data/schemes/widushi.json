{
  "scheme_id": "C25",
  "slug": "widushi",
  "name": "Women’s Instinct for Developing and Ushering in Scientific Heights & Innovation",
  "government_level": "Central",
  "geography": "India",
  "source_url": "https://www.myscheme.gov.in/schemes/widushi",
  "collected_on": "2026-10-28",
