  "sample_only": false,
  "sections": {
    "details": {
      "capture_status": "captured",
      "items": [
        {
          "text": "A new programme “Women's Instinct for Developing and Ushering in Scientific Heights & Innovations (WIDUSHI)” is started by the Department of Science and Technology (DST) under its umbrella scheme “Women in Science and Engineering-KIRAN (WISE-KIRAN)” for senior women scientists to harness their knowledge and potential for the betterment of Science and Society. WIDUSHI programme aims to encourage and support senior women scientists to conduct research in interdisciplinary areas of Science and Technology.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.detailedDescription[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Proposals are invited from senior women scientists in the following scientific disciplines:",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.detailedDescription[0].children[1]",
          "channel": null,
          "heading": "Proposals are invited from senior women scientists in the following scientific disciplines:"
        },
        {
          "text": "Physical & Mathematical Sciences",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.detailedDescription[0].children[2].children[0]",
          "channel": null,
          "heading": "Proposals are invited from senior women scientists in the following scientific disciplines:"
        },
        {
          "text": "Chemical Sciences",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.detailedDescription[0].children[2].children[1]",
          "channel": null,
          "heading": "Proposals are invited from senior women scientists in the following scientific disciplines:"
        },
        {
          "text": "Life Sciences",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.detailedDescription[0].children[2].children[2]",
          "channel": null,
          "heading": "Proposals are invited from senior women scientists in the following scientific disciplines:"
        },
        {
          "text": "Earth & Atmospheric Sciences",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.detailedDescription[0].children[2].children[3]",
          "channel": null,
          "heading": "Proposals are invited from senior women scientists in the following scientific disciplines:"
        },
        {
          "text": "Engineering & Technology",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.detailedDescription[0].children[2].children[4]",
          "channel": null,
          "heading": "Proposals are invited from senior women scientists in the following scientific disciplines:"
        },
        {
          "text": "S&T based Societal Research",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.detailedDescription[0].children[2].children[5]",
          "channel": null,
          "heading": "Proposals are invited from senior women scientists in the following scientific disciplines:"
        },
        {
          "text": "Target Group: The target group is categorized into the following 2 categories:",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.detailedDescription[0].children[3]",
          "channel": null,
          "heading": "Target Group: The target group is categorized into the following 2 categories:"
        },
        {
          "text": "Category-A: Retiring or retired Women Scientist",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.detailedDescription[0].children[4]",
          "channel": null,
          "heading": "Target Group: The target group is categorized into the following 2 categories:"
        },
        {
          "text": "Category-B: Senior Women Scientists who are not in regular employment",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.detailedDescription[0].children[5]",
          "channel": null,
          "heading": "Target Group: The target group is categorized into the following 2 categories:"
        },
        {
          "text": "Project Duration:",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.detailedDescription[0].children[6]",
          "channel": null,
          "heading": "Target Group: The target group is categorized into the following 2 categories:"
        },
        {
          "text": "The maximum duration of the project is 5 years.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.detailedDescription[0].children[7]",
          "channel": null,
          "heading": "Target Group: The target group is categorized into the following 2 categories:"
        }
      ]
    },
    "benefits": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Category A:",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.benefits[0].children[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "1.\tThe Programme provides fellowship to the Principal Investigator @₹75,000/- per month, One Research Assistant, Research Grant of ₹5.0 Lakh per year and Institutional overhead charges @₹1.00 lakh per annum.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.benefits[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Category B:",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.benefits[0].children[2].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "1.\tThe Programme provides fellowship to the Principal Investigator @₹85,000/- per month, One Research Assistant, Research Grant of ₹5.0 Lakh per year and Institutional overhead charges @₹1.00 lakh per annum.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.benefits[0].children[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Co-Investigator (Co-I):",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.benefits[0].children[4].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "'WIDUSHI' fellow should choose a permanent faculty as Co-I (male/female) of the project for academic and administrative support in project implementation. The service of Co-I has to be due for a period not less than the proposed period of the WIDUSHI project. The Co-I is not eligible for any separate grants under the programme.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.schemeContent.benefits[0].children[5]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "eligibility": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Category A: The following are the primary eligibility criteria-",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Employment: Women Scientists who are permanent employees but retiring in a year or already retired/superannuated from government academic/research institutions.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[1].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Age: 57-62 years",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[1].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Qualification: Women Scientists having Ph.D. in Basic/Applied Sciences or equivalent degree.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[1].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Research Experience: Minimum 2 R&D projects as Principal Investigator with excellent track record.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[1].children[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Publications: Minimum 20 research publications with impact factor.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[1].children[4]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Category B: The following are the primary eligibility criteria-",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[2].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Employment: Women who are not permanent employees in any institution but working temporarily and have completed 2 independent research projects as Principal Investigator.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[3].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Age: 45-62 years",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[3].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Qualification: Women Scientists having Ph.D. in Basic/Applied Sciences or equivalent degree.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[3].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Research Experience: Minimum 2 R&D projects as Principal Investigator with excellent track record.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[3].children[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Publications: Minimum 10 research publications with impact factor.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[3].children[4]",
          "channel": null,
          "heading": null
        }
      ]
    },
