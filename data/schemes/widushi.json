    "application_process": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Registration Process:",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.applicationProcess[0].process[0].children[0].children[0]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 01: The proposal submission is open throughout the year.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.applicationProcess[0].process[0].children[1]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 02: The proposal format is available at https://dst.gov.in/, https://onlinedst.gov.in/ and https://online-wosa.gov.in/ under WISE-KIRAN Division.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.applicationProcess[0].process[0].children[2]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 03: Log on to https://onlinedst.gov.in/ to access the home page of the “DST e-PMS Portal”.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.applicationProcess[0].process[0].children[3]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 04: Click on “New PI Registration” and fill in the requisite details for New user registration. In the ‘Personal Information’ section, fill- department, Institute, and Institute Address as per the Host Institute identified for the WIDUSHI programme.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.applicationProcess[0].process[0].children[4]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 05: After logging-in, click on the “Submit proposal” option and then “Initiate New Proposal”. Search the programme by Division Name or Call By Programme/Scheme.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.applicationProcess[0].process[0].children[5]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 06: Select the Programme/Scheme name (WIDUSHI) and then click on “Start Submission”. Select the category and fill in all the information as required in the form.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.applicationProcess[0].process[0].children[6]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 07: After filling in all the particulars, preview your details before the final submission of the application form by clicking on the “Preview” button. The preview page will display all the facts/ particulars that you have mentioned. If there is something that you wish to update, go back and correct the information, or else proceed with the filled details by clicking on the “Submit” button to finally push data into the server.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.applicationProcess[0].process[0].children[7]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 08: Candidates are advised to carefully fill and verify the details filled in the online application themselves as no change will be possible/ entertained after clicking the FINAL SUBMIT BUTTON.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.applicationProcess[0].process[0].children[8]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Selection Process:",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.applicationProcess[0].process[0].children[9].children[0]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "The project proposals received will be screened and the Principal Investigator (PI) of ‘screened-in’ proposals will be called for presentation before Programme Advisory Committee for final recommendation. The final decision of DST will be communicated to the applicants only after obtaining due administrative and financial approvals.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.applicationProcess[0].process[0].children[10]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "For detailed information:",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.applicationProcess[0].process[0].children[11].children[0]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "•\tPlease refer WIDUSHI Guidelines at www.dst.gov.in and online-wosa.gov.in. For further clarification email enquiry-wosdst@gov.in.",
          "source_url": "https://www.myscheme.gov.in/schemes/widushi",
          "source_path": "en.applicationProcess[0].process[0].children[12]",
          "channel": "Online",
          "heading": null
        }
      ]
    },
