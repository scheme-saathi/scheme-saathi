{
  "scheme_id": "C29",
  "slug": "igndps",
  "name": "Indira Gandhi National Disability Pension Scheme",
  "government_level": "Central",
  "geography": "India",
  "source_url": "https://www.myscheme.gov.in/schemes/igndps",
  "collected_on": "2026-10-28",
  "review_status": "approved",
  "availability_status": "open",
  "sample_only": false,
  "sections": {
    "details": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Indira Gandhi National Disability Scheme was launched on February 2009 by the Ministry of Rural Development headed by the Central Government to support the disabled people in our country. This scheme introduced under National Social Assistance Program provides monthly pension to disabled people for the prosperity of their lives. Any disabled person whose age is more than 18 years, and with disability 80% or more belonging to the poverty line can apply for this scheme.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.schemeContent.detailedDescription[0]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "benefits": {
      "capture_status": "captured",
      "items": [
        {
          "text": "A pension of Rs.300/- per month is provided to Divyangjan between 18-79 years.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.schemeContent.benefits[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "A pension of Rs.500/- per month will be provided to Divyangjan aged 80 years and above.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.schemeContent.benefits[0].children[1]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "eligibility": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The eligibility criteria for a disabled person to avail of the benefits are as follows.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The age of the applicant should be 18 years and above.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[2].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should be a resident of India.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[2].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should be a physically or mentally disabled person.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[2].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant’s disability should be more than 80%.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[2].children[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Dwarfs are also eligible for this scheme.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[2].children[4]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should belong to the Below Poverty Line.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[2].children[5]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "exclusions": {
      "capture_status": "not_in_source",
      "items": []
    },
    "application_process": {
      "capture_status": "captured",
      "items": [
        {
          "text": "One can download UMANG App or visit website https://web.umang.gov.in/web_new/home",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[0].process[0].children[0]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "The citizen can login using mobile number and OTP.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[0].process[0].children[1]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Once logged In, citizen can search for NSAP.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[0].process[0].children[2]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Click on “Apply Online”",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[0].process[0].children[3]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Fill the basic details, choose the mode of payment of pension, upload photo and click on “Submit”.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[0].process[0].children[4]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Individuals can submit completely filled applications to the Gram Panchayat / Block Office in the rural area and the Municipality / Municipal Council in the urban area, as per eligibility.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[1].process[0].children[0]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "A Verification Officer or Verification Team under an authorized officer verifies the applications with reference to facts related to eligibility",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[1].process[0].children[1]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "The Verification Officer make the necessary recommendation for sanction or rejection with reasons.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[1].process[0].children[2]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "The list of applicants with the recommendations of the Verifying Authority is discussed in the Gram Sabha in rural areas or Ward Sabha / Area Sabha as designated by the State Government in urban areas and thereafter in the Gram Panchayats and Municipalities.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[1].process[0].children[3]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "If the time limits are not adhered to by Gram Sabha / Ward Sabhas, Gram Panchayats / Municipalities the Verification Officer directly submits his recommendations to the Sanctioning Authority under intimation to the Gram Panchayat / Municipality.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[1].process[0].children[4]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "After receipt of applications which are verified and recommended by the Gram Sabha / Ward Committee / Area Sabha, the Sanctioning Authority convey approval to the applicant in the form of a Sanction Order with a copy to Gram Panchayat / Municipality concerned.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[1].process[0].children[5]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "The Sanctioning Authority issues Sanction Order under his seal",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[1].process[0].children[6]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "Every beneficiary who has been sanctioned pension under schemes of NSAP are issued a Pension Passbook. The Passbook contain details of the Sanction Order, particulars of the pensioner and disbursement details",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[1].process[0].children[7]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "The list of beneficiaries to whom sanctions are issued is displayed at the Gram Panchayat / Ward / Municipal Office and updated every three months.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[1].process[0].children[8]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "The Pension amount is directly paid to the beneficiaries through the Direct Benefit Transfer (DBT) process to their post office or bank account.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "en.applicationProcess[1].process[0].children[9]",
          "channel": "Offline",
          "heading": null
        }
      ]
    },
    "required_documents": {
      "capture_status": "captured",
      "items": [
        {
          "text": "BPL Card",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "documents.en.documents_required[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Aadhaar card",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "documents.en.documents_required[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Age Proof - For age, the birth certificate or school certificate may be relied on. In their absence ration card and EPIC may be considered. If there is no valid document, any Medical Officer of any government hospital may be authorized to issue the age certificate.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "documents.en.documents_required[0].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Disability certificate:- Disability certificate (80% and More) issued from Chief Medical Officer, Community Health Centre or Primary Health Centre will be accepted.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "documents.en.documents_required[0].children[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Passport Size Photographs.",
          "source_url": "https://www.myscheme.gov.in/schemes/igndps",
          "source_path": "documents.en.documents_required[0].children[4]",
          "channel": null,
          "heading": null
        }
      ]
    }
  },
