  "sections": {
    "details": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The \"Grant in Aid to Old Age Home\" is a scheme by the Department of Social Justice & Special Assistance, Govt. of Maharashtra. In this scheme, grants are provided to the NGOs for accommodating old men and women, destitute, and disabled victims, into Old age Homes, and providing them with facilities such as food, accommodation, resort, Free lodging & Boarding & Medical Assistance, etc. Only citizens who are permanent residents of the state of Maharashtra are eligible to apply for this scheme. This scheme is 100% funded by the Govt. of Maharashtra.",
          "source_url": "https://www.myscheme.gov.in/schemes/gaoah",
          "source_path": "en.schemeContent.detailedDescription[0]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "benefits": {
      "capture_status": "captured",
      "items": [
        {
          "text": "In this scheme, grants are provided to the NGOs for accommodating old men and women, destitute, and disabled victims, into Old age Homes, and providing them with facilities such as food, accommodation, resort, Free lodging & Boarding & Medical Assistance, etc.",
          "source_url": "https://www.myscheme.gov.in/schemes/gaoah",
          "source_path": "en.schemeContent.benefits[0]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "eligibility": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The applicant should be a registered Non-Governmental Organization (NGO).",
          "source_url": "https://www.myscheme.gov.in/schemes/gaoah",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should only accommodate old/destitute/disabled victims.",
          "source_url": "https://www.myscheme.gov.in/schemes/gaoah",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "In the case of old men, the age should be 60 years and above. In the case of old women, the age should be 55 years and above.",
          "source_url": "https://www.myscheme.gov.in/schemes/gaoah",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The old age person should be a citizen of India.",
          "source_url": "https://www.myscheme.gov.in/schemes/gaoah",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The old age person should be a permanent resident of the state of Maharashtra.",
          "source_url": "https://www.myscheme.gov.in/schemes/gaoah",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[4]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "exclusions": {
      "capture_status": "not_in_source",
      "items": []
    },
    "application_process": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Step 1: Visit the District Social Welfare Office, and request a hard copy of the format of the application form for the scheme from the concerned authority.",
          "source_url": "https://www.myscheme.gov.in/schemes/gaoah",
          "source_path": "en.applicationProcess[0].process[0]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "Step 2: In the application form, fill in all the mandatory fields, paste the passport-sized photograph (signed across), and attach all the (self-attested) mandatory documents.",
          "source_url": "https://www.myscheme.gov.in/schemes/gaoah",
          "source_path": "en.applicationProcess[0].process[1]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "Step 3: Submit the duly filled and signed application form along with the documents to the Assistant Commissioner, District Social Welfare Office.",
          "source_url": "https://www.myscheme.gov.in/schemes/gaoah",
          "source_path": "en.applicationProcess[0].process[2]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "Step 4: Acquire the receipt/acknowledgment of the successful submission of the application form from the District Social Welfare Office.",
          "source_url": "https://www.myscheme.gov.in/schemes/gaoah",
          "source_path": "en.applicationProcess[0].process[3]",
          "channel": "Offline",
          "heading": null
        }
      ]
    },
