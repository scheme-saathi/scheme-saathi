{
  "scheme_id": "C17",
  "slug": "nikshay",
  "name": "Nikshay Poshan Yojana",
  "government_level": "Central",
  "geography": "India",
  "source_url": "https://www.myscheme.gov.in/schemes/nikshay",
  "collected_on": "2026-10-28",
