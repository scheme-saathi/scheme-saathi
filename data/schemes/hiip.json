          "source_url": "https://www.myscheme.gov.in/schemes/hiip",
          "source_path": "documents.en.documents_required[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Proof of Age (Birth Certificate, etc).",
          "source_url": "https://www.myscheme.gov.in/schemes/hiip",
          "source_path": "documents.en.documents_required[0].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Residential Certificate / Domicile Certificate of the State of Maharashtra.",
          "source_url": "https://www.myscheme.gov.in/schemes/hiip",
          "source_path": "documents.en.documents_required[0].children[3]",
          "channel": null,
          "heading": null
