{
  "scheme_id": "C26",
  "slug": "tare",
  "name": "Teachers Associateship for Research Excellence",
  "government_level": "Central",
  "geography": "India",
  "source_url": "https://www.myscheme.gov.in/schemes/tare",
  "collected_on": "2026-10-28",
  "review_status": "approved",
  "availability_status": "unverified",
  "sample_only": false,
  "sections": {
    "details": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The scheme “Teachers Associateship for Research Excellence (TARE)” was launched by the Science and Engineering Research Board, Department of Science & Technology, Government of India which aims to facilitate the mobility of faculty members working in a regular capacity in State Universities / Colleges and in private Academic Institutions to carry out research work in an established public-funded central institution such as IITs, IISc, IISERS, National Institutions (NITs, CSIR, ICAR, ICMR labs and other central institutions) and Central Universities, located preferably nearer to the institution where the faculty member is working. Research work will be carried out in such a manner to ensure that the PI continues to work in the host institute as well as his / her parent institute on mutually agreed terms between the PI and Mentor.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.schemeContent.detailedDescription[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Areas Covered under the scheme:",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.schemeContent.detailedDescription[0].children[1]",
          "channel": null,
          "heading": "Areas Covered under the scheme:"
        },
        {
          "text": "The scheme covers areas under Life Sciences, Physical Sciences, Chemical Sciences, Engineering Sciences, Earth and Atmospheric Sciences, and Mathematical Sciences, including interdisciplinary areas.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.schemeContent.detailedDescription[0].children[2]",
          "channel": null,
          "heading": "Areas Covered under the scheme:"
        },
        {
          "text": "Duration of Support:",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.schemeContent.detailedDescription[0].children[3].children[0]",
          "channel": null,
          "heading": "Areas Covered under the scheme:"
        },
        {
          "text": "The duration of support is three years.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.schemeContent.detailedDescription[0].children[4]",
          "channel": null,
          "heading": "Areas Covered under the scheme:"
        }
      ]
    },
    "benefits": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Research fellowship of ₹60,000/- per year (in addition to the researcher’s own salary) will be provided subject to completion of a minimum of 90 days of research work per year in the host institution.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.schemeContent.benefits[0].children[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Research grant of ₹5 lakhs per annum (50% each to host and parent institution) and overheads (as per SERB norms) will be provided.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.schemeContent.benefits[0].children[0].children[1]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "eligibility": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Indian citizens residing in India holding a Ph.D. degree in Science/Engineering or MS/MD in Medicine are eligible to apply.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant(s) must hold a regular academic/research position in State Universities/ Colleges and private Academic Institutions.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Applicant should not hold any ongoing research projects or any fellowship at the time of submission of application.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The upper age limit for the award is 45 years at the time of the submission of the application. Age relaxation of 5 (five) years will be given to candidates belonging to SC/ST/OBC/Physically Challenged & Women candidates.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0].children[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Mentor should be at the level of Associate Professor/Scientist E, or higher level.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0].children[4]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Only one candidate will be allowed to work with a mentor at any given point of time.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0].children[5]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "exclusions": {
      "capture_status": "not_in_source",
      "items": []
    },
    "application_process": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Step 01: The call for proposals will be notified through the website www.serbonline.in and www.serb.gov.in",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.applicationProcess[0].process[0].children[0]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 02: Applicant(s) should first register on the online website.  Click here to register",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.applicationProcess[0].process[0].children[1]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 03: After login, the applicant(s) are required to fill all the mandatory fields in the Profile Detail section under User Profile, which includes Bio-data, Photo, and Institute Address, etc.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.applicationProcess[0].process[0].children[2]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 04: Summary of the project proposal; Project Title (max 500 characters), Abstract of the proposed work (max 3000 characters), Keywords (max 6), Objectives of the project (max 1500 characters), Expected output and outcome of the proposal (max 1500 characters), have to be entered at the time of proposal submission.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.applicationProcess[0].process[0].children[3]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 05: Other relevant information of the proposal must be uploaded in a single PDF file not more than 10 MB as other technical documents (OTD).",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.applicationProcess[0].process[0].children[4]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Note: The proposals will be evaluated through peer review processes as per SERB guidelines.",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "en.applicationProcess[0].process[0].children[5]",
          "channel": "Online",
          "heading": null
        }
      ]
    },
    "required_documents": {
      "capture_status": "captured",
      "items": [
        {
          "text": "1.\tPassport size photograph",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "documents.en.documents_required[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "2.\tBiodata of the applicant (under the user profile section)",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "documents.en.documents_required[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "3.\tOther technical details of the proposal",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "documents.en.documents_required[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "4.\tCertificate from the Investigator",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "documents.en.documents_required[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "5.\tEndorsement certificate from the Head of Parent Institution",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "documents.en.documents_required[4]",
          "channel": null,
          "heading": null
        },
        {
          "text": "6.\tEndorsement Letter from the Head of the host Institution",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "documents.en.documents_required[5]",
          "channel": null,
          "heading": null
        },
        {
          "text": "7.\tCV of the Mentor",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "documents.en.documents_required[6]",
          "channel": null,
          "heading": null
        },
        {
          "text": "8.\tCategory certificate",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "documents.en.documents_required[7]",
          "channel": null,
          "heading": null
        },
        {
          "text": "9.\tAge proof certificate",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "documents.en.documents_required[8]",
          "channel": null,
          "heading": null
        },
        {
          "text": "10.\tJoining report",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "documents.en.documents_required[9]",
          "channel": null,
          "heading": null
        },
        {
          "text": "11.\tMandatory 90 days attendance certificate by the end of the financial year",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "documents.en.documents_required[10]",
          "channel": null,
          "heading": null
        },
        {
          "text": "12.\tPlagiarism undertaking",
          "source_url": "https://www.myscheme.gov.in/schemes/tare",
          "source_path": "documents.en.documents_required[11]",
          "channel": null,
          "heading": null
        }
      ]
    }
  },
