    "details": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Being implemented particularly for the (Scheduled Caste) Charmakar Community, the \"Gattai Stall Scheme\" is a scheme by the Leather Industries Development Corporation (LIDCOM), Govt. of Maharashtra. This scheme is being implemented for the Roadsides Cobblers. The scheme provides a 100% subsidy for the erection of a Tin Stall of Size 4’ x 5’ x 6.5’ costing ₹16,367/- per stall and ₹500/- incidental charges. Only citizens who are permanent residents of the state of Maharashtra are eligible to apply for this scheme. This scheme is completely funded by the Govt. of Maharashtra. The main objective of LIDCOM is to implement various schemes to uplift the lifestyle of Charmakars (Dhor, Chambhar, Holar, Mochi, etc.) who are economically weak and below the poverty line and with an intention to develop them educationally, economically, and socially so as to give them a respectable place in society.",
          "source_url": "https://www.myscheme.gov.in/schemes/lgss",
          "source_path": "en.schemeContent.detailedDescription[0]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "benefits": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The scheme provides a 100% subsidy for the erection of a Tin Stall of Size 4’ x 5’ x 6.5’ costing ₹16,367/- per stall and ₹500/- incidental charges.",
          "source_url": "https://www.myscheme.gov.in/schemes/lgss",
          "source_path": "en.schemeContent.benefits[0].children[0]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "eligibility": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The applicant should be a citizen of India.",
          "source_url": "https://www.myscheme.gov.in/schemes/lgss",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should be a Roadside Cobbler identified by the Gram Panchayat.",
          "source_url": "https://www.myscheme.gov.in/schemes/lgss",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should be a permanent resident of Maharashtra State.",
          "source_url": "https://www.myscheme.gov.in/schemes/lgss",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should be in the 18 to 50 years age group.",
          "source_url": "https://www.myscheme.gov.in/schemes/lgss",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should be from Charmakar Community only (Dhor, Chambhar, Holar, Mochi, etc.).",
          "source_url": "https://www.myscheme.gov.in/schemes/lgss",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[4]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The annual income of the family of the applicant should be less than or equal to ₹1,00,000/-.",
          "source_url": "https://www.myscheme.gov.in/schemes/lgss",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[5]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should have knowledge of the business for which he has applied for the loan.",
          "source_url": "https://www.myscheme.gov.in/schemes/lgss",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[6]",
          "channel": null,
          "heading": null
        }
      ]
    },
