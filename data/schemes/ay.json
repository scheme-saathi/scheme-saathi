{
  "scheme_id": "C28",
  "slug": "ay",
  "name": "Agnipath Yojana",
  "government_level": "Central",
  "geography": "India",
  "source_url": "https://www.myscheme.gov.in/schemes/ay",
  "collected_on": "2026-10-28",
  "review_status": "approved",
