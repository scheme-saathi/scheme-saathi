    "eligibility": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The applicant must be a citizen of India.",
          "source_url": "https://www.myscheme.gov.in/schemes/ay",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "For the 2022 intake, the age of the applicant should be between 17.5 to 23 years. For the subsequent intakes, the age of the applicant should be between 17.5 to 21 years.",
          "source_url": "https://www.myscheme.gov.in/schemes/ay",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant must fulfill the educational qualifications and physical and medical standards set by the Indian Army / Indian Navy / Indian Air Force.",
          "source_url": "https://www.myscheme.gov.in/schemes/ay",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Note 01: The Agniveers will be enrolled in the Forces under respective Service Acts for a period of four years. They would form a distinct rank in the Armed Forces, different from any other existing ranks.",
          "source_url": "https://www.myscheme.gov.in/schemes/ay",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[1].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Note 02: Upon the completion of four years of service, based on organizational requirements and policies promulgated by the Armed Forces from time to time, Agniveers will be offered an opportunity to apply for permanent enrolment in the Armed Forces.",
          "source_url": "https://www.myscheme.gov.in/schemes/ay",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[1].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Note 03: The applications for permanent enrolment will be considered in a centralized manner based on objective criteria including performance during their four-year engagement period and up to 25% of each specific batch of Agniveers will be enrolled in the regular cadre of the Armed Forces. The selection will be the exclusive jurisdiction of the Armed Forces.",
          "source_url": "https://www.myscheme.gov.in/schemes/ay",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[1].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Note 04: Agniveers will meet the medical eligibility conditions laid down for enrolment in the armed forces as applicable to respective categories/trades.",
          "source_url": "https://www.myscheme.gov.in/schemes/ay",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[1].children[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Note 05: The educational qualification for Agniveers will remain as in vogue for enrollment in various categories.",
          "source_url": "https://www.myscheme.gov.in/schemes/ay",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[1].children[4]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "exclusions": {
