    "details": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The National Energy Conservation Award under the Ministry of Power, Government of India, recognizes organizations for their outstanding efforts in energy conservation and energy efficiency.A total of 65 awards are given under different categories, including Tier-I and Tier-II. The award ceremony is held every year on 14th December on the occasion of National Energy Conservation Day.",
          "source_url": "https://www.myscheme.gov.in/schemes/neca",
          "source_path": "en.schemeContent.detailedDescription[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Objective",
          "source_url": "https://www.myscheme.gov.in/schemes/neca",
          "source_path": "en.schemeContent.detailedDescription[1]",
          "channel": null,
          "heading": "Objective"
        },
        {
          "text": "a) Scope: The scope of the Awards is to cover sectors(Industries, Building, Transport, Institutions, Equipments) which have a share of around 56% of India’s total Electricity consumption(Energy Statistics 2022, MOSPI).",
          "source_url": "https://www.myscheme.gov.in/schemes/neca",
          "source_path": "en.schemeContent.detailedDescription[2]",
          "channel": null,
          "heading": "Objective"
        },
        {
          "text": "b) Purpose: The purpose of the awardis to recognize/reward organizations for the exemplary efforts on Energy Conservation and Energy Efficiency. It can be categorized into National Award(Tier-I/Tier-II) category.",
          "source_url": "https://www.myscheme.gov.in/schemes/neca",
          "source_path": "en.schemeContent.detailedDescription[3]",
          "channel": null,
          "heading": "Objective"
        }
      ]
    },
    "benefits": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Certificate & Trophy",
          "source_url": "https://www.myscheme.gov.in/schemes/neca",
          "source_path": "en.schemeContent.benefits[0].children[0]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "eligibility": {
      "capture_status": "captured",
      "items": [
        {
          "text": "All organizations are eligible to apply free of cost for the National Energy Conservation Award subject to the condition that their sector should be eligible for Award for a particular year.",
          "source_url": "https://www.myscheme.gov.in/schemes/neca",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "exclusions": {
      "capture_status": "captured",
      "items": [
        {
          "text": "However, the following organizations cannot apply for the Award:",
          "source_url": "https://www.myscheme.gov.in/schemes/neca",
          "source_path": "en.schemeContent.exclusions[0]",
          "channel": null,
          "heading": "However, the following organizations cannot apply for the Award:"
        },
        {
          "text": "a. Organizations having legal issues, blacklisted, or defaulters in any of the government schemes.",
          "source_url": "https://www.myscheme.gov.in/schemes/neca",
          "source_path": "en.schemeContent.exclusions[1]",
          "channel": null,
          "heading": "However, the following organizations cannot apply for the Award:"
        },
        {
          "text": "b. Defaulters/repeated defaulters under the Perform Achieve and Trade scheme of the Bureau of Energy Efficiency, Ministry of Power.",
          "source_url": "https://www.myscheme.gov.in/schemes/neca",
          "source_path": "en.schemeContent.exclusions[2]",
          "channel": null,
          "heading": "However, the following organizations cannot apply for the Award:"
        }
      ]
    },
