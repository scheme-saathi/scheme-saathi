          "source_path": "documents.en.documents_required[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Passport size photograph",
          "source_url": "https://www.myscheme.gov.in/schemes/yhs",
          "source_path": "documents.en.documents_required[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Proof of identity, such as a copy of your passport, driver's license, or Aadhaar card",
