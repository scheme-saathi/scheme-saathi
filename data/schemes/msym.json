  "sections": {
    "details": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The scheme \"Mahila Samridhi Yojana\" is administered by the Department of Social Justice & Special Assistance, Government of Maharashtra, and funded by the National Scheduled Castes Finance and Development Corporation (NSFDC). The scheme aims to uplift economically weaker women from the Charmakar Community. The scheme focuses on providing educational, economic, and social development to ensure a respectable position in society for Charmakars (Dhor, Chambhar, Holar, Mochi, etc.). Eligible female beneficiaries from the Charmakar Community are granted loans ranging from ₹25,000/- to ₹50,000/- at a low interest rate of 4% per annum.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.schemeContent.detailedDescription[0].children[0].children[0]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "benefits": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Loan ranging from ₹25,000/- to ₹50,000/- is provided at a low interest rate of 4% per annum.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.schemeContent.benefits[0]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "eligibility": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The applicant should be a female.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should belong to the Charmakar Community.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant's age should be between 18 and 50 years.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should be a permanent resident of Maharashtra.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant must have knowledge of the business for which the loan is being applied.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[4]",
          "channel": null,
          "heading": null
        },
        {
          "text": "For the 50% Subsidy Scheme and Margin Money, the applicant's annual income must be below the poverty line.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[5]",
          "channel": null,
          "heading": null
        },
        {
          "text": "For the NSFDC Scheme, the applicant's annual income should be below ₹98,000 for rural areas and ₹1,20,000 for urban areas.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[6]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Relaxation/Preference/Priority",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[1]",
          "channel": null,
          "heading": "Relaxation/Preference/Priority"
        },
        {
          "text": "Widows and divorcees are given priority.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[2]",
          "channel": null,
          "heading": "Relaxation/Preference/Priority"
        }
      ]
    },
    "exclusions": {
      "capture_status": "not_in_source",
      "items": []
    },
    "application_process": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Step 1: The interested applicant should visit (during office hours) the District Office of LIDCOM and request the hard copy of the prescribed format of the application form from the concerned authority.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.applicationProcess[0].process[0]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "Step 2: In the application form, fill in all the mandatory fields, paste the passport-sized photograph (signed across, if required), and attach copies of all the mandatory documents (self-attest, if required).",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.applicationProcess[0].process[1]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "Step 3: Submit the duly filled and signed application form along with the documents, within the prescribed period (if any), to the District Office of LIDCOM.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.applicationProcess[0].process[2]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "Step 4: Request a receipt or acknowledgement from the concerned authority to whom the application has been submitted. Ensure that the receipt contains essential details such as the date and time of submission, and a unique identification number (if applicable).",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.applicationProcess[0].process[3]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "NOTE: Ensure that the application is submitted within the prescribed period, if any.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "en.applicationProcess[0].process[4]",
          "channel": "Offline",
          "heading": null
        }
      ]
    },
    "required_documents": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The applicant must provide an income and caste certificate issued by an authorized government officer.",
          "source_url": "https://www.myscheme.gov.in/schemes/msym",
          "source_path": "documents.en.documents_required[0]",
          "channel": null,
          "heading": null
        }
      ]
    }
  },
