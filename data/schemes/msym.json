{
  "scheme_id": "M09",
  "slug": "msym",
  "name": "Mahila Samridhi Yojana (Maharashtra)",
  "government_level": "State",
  "geography": "Maharashtra",
  "source_url": "https://www.myscheme.gov.in/schemes/msym",
