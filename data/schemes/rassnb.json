  "sections": {
    "details": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The scheme \"Ramai Awas (Gharkul) Scheme for SC & Nav-Buddha (Urban and Rural)\" is a housing scheme by the Department of Social Justice & Special Assistance of the Government of Maharashtra. The scheme aims to raise the standard of living of the individuals from the Scheduled Caste and Nav-Buddha communities residing in rural & urban areas of Maharashtra.",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.schemeContent.detailedDescription[0]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "benefits": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The benefits vary with the area that the beneficiary resides in -",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.schemeContent.benefits[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Rural Area: ₹ 1,00,000/- (Beneficiary's share is Nil)",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.schemeContent.benefits[1].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Municipal Area: ₹ 1,50,000/- (Beneficiary's share is 7.5%)",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.schemeContent.benefits[1].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Municipal Corporation: ₹ 2,00,000/- (Beneficiary's share is 10%)",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.schemeContent.benefits[1].children[2]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "eligibility": {
      "capture_status": "captured",
      "items": [
        {
          "text": "1. The applicant should have lived for 15 years in Maharashtra.",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "2. The applicant's annual income limit is as under -",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "For Rural Area, ₹1,00,000/- per annum.",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[2].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "For Municipal Area, ₹1,50,000/- per annum.",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[2].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "For Municipal Corporation, ₹2,00,000/- per annum.",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[2].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "3. Only one person in the family will get the benefit.",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "4. The applicant should have his/her own land",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[4]",
          "channel": null,
          "heading": null
        },
        {
          "text": "5. The applicant should not be receiving the benefits of any other housing scheme of the Government.",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[5]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Reservation/Relaxation/Priority",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[6].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Priority will be given to applicants from the Below Poverty Line (BPL).",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[7]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "exclusions": {
      "capture_status": "not_in_source",
      "items": []
