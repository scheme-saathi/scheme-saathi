    "application_process": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Step 1: The interested applicant should visit (during office hours) one of the following officers and request a hard copy of the prescribed format of the application form from the concerned authority -",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.applicationProcess[0].process[0]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Assistant Commissioner, Social Welfare Office",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.applicationProcess[0].process[1].children[0]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Project Director, District Rural Development Agency",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.applicationProcess[0].process[1].children[1]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "District Council / Municipal Commissioner",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.applicationProcess[0].process[1].children[2]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 2: In the application form, fill in all the mandatory fields, paste the passport-sized photograph (signed across, if required), and attach copies of all the mandatory documents (self-attest, if required).",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.applicationProcess[0].process[2]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 3: Submit the duly filled and signed application form along with the documents, within the prescribed period (if any), to the concerned authority.",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.applicationProcess[0].process[3]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 4: Request a receipt or acknowledgement from the concerned authority to whom the application has been submitted. Ensure that the receipt contains essential details such as the date and time of submission, and a unique identification number (if applicable).",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.applicationProcess[0].process[4]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "NOTE: Ensure that the application is submitted within the prescribed period, if any.",
          "source_url": "https://www.myscheme.gov.in/schemes/rassnb",
          "source_path": "en.applicationProcess[0].process[5]",
          "channel": "Online",
          "heading": null
        }
      ]
    },
