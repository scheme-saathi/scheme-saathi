    "details": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The \"Medical Assistance for the Treatment of Critical Illness\" scheme was launched by the Maharashtra Building And Other Construction Workers Welfare Board (MBOCWW), Labour Department Maharashtra. Under this scheme, medical assistance of ₹1,00,000/- for the treatment of serious ailments for registered worker and his/her family members. (the benefit can be availed only after 26th July 2014 as the benefit is covered under the Mediclaim & Personal Accident Insurance scheme).",
          "source_url": "https://www.myscheme.gov.in/schemes/matci",
          "source_path": "en.schemeContent.detailedDescription[0]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "benefits": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Financial assistance of ₹1,00,000/- is provided for medical treatment.",
          "source_url": "https://www.myscheme.gov.in/schemes/matci",
          "source_path": "en.schemeContent.benefits[0].children[0]",
          "channel": null,
          "heading": "Financial assistance of ₹1,00,000/- is provided for medical treatment."
        }
      ]
    },
    "eligibility": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The worker must be engaged in building or construction work.",
          "source_url": "https://www.myscheme.gov.in/schemes/matci",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The worker should be registered under the Maharashtra Building and Other Construction Workers Welfare Board (MBOCWW).",
          "source_url": "https://www.myscheme.gov.in/schemes/matci",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The worker or family member must be undergoing treatment for a serious illness or critical medical condition.",
          "source_url": "https://www.myscheme.gov.in/schemes/matci",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[2]",
          "channel": null,
          "heading": null
        }
      ]
    },
