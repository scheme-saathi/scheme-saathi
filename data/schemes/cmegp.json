    "eligibility": {
      "capture_status": "captured",
      "items": [
        {
          "text": "1)The Age of the applicant should be between 18 to 45. For Special category (including SC/ST/Women/ Ex-servicemen/Differently abled) age is relaxed by 5 years.",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "2)The Occupation of the applicant should be unemployed youth, Youth willing to establish new ventures.",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "3)The Annual Income of the Applicant/Family/Parent/Guardian should No criteria LPA",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "4)The Gender of the applicant should be Male and Female",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "5)The Marital Status of the applicant should be for all",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[4]",
          "channel": null,
          "heading": null
        },
        {
          "text": "6)The Educational Qualification of the applicant should be minimum 7th standard pass for   project/unit above Rs. 10 lac and for project/units above Rs.25 lac the required educational criterion for the applicant is minimum 10th standard pass.",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[5]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "exclusions": {
      "capture_status": "captured",
      "items": [
        {
          "text": "1) Only one person from a family will be eligible under the scheme. (Definition of family includes Self and spouse)",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.schemeContent.exclusions[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "2) Existing Units and units that have availed benefit under PMRY, REGP, PMEGP or any other subsidy linked scheme of Government of India or State Government and also units that have already availed Government Subsidy under any other scheme of Government of India or State Government are not eligible under the scheme.",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.schemeContent.exclusions[0].children[1]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "application_process": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Step 01:  Fill online application on portal https://maha-cmegp.gov.in",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.applicationProcess[0].process[0].children[0]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 02: District level Scrutiny and Coordination Sub-Committee (DLSCC) constituted under the Chairmanship of respective GM, DICs will scrutinize the applications and prepare a primary list of eligible applicants.",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.applicationProcess[0].process[0].children[2]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 03: primary eligible applicants list will be approved by DLTFC and then forwarded to bank.",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.applicationProcess[0].process[0].children[4]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 04: Bank Sanctioning &  Entrepreneurship Development Programme (EDP)  training &  Disbursment",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.applicationProcess[0].process[0].children[6]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 05: Subsidy claim by Bank to GM",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.applicationProcess[0].process[0].children[8]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 06: Approval of claim by HO and disbursement of margin money viz. nodal bank",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.applicationProcess[0].process[0].children[10]",
          "channel": "Online",
          "heading": null
        },
        {
          "text": "Step 07: completion of three successful years of activity and following the timely repayment schedule as informed by the bank, the margin money in the form of grant-in-aid will be re-appropriated in the applicant’s loan account after confirmation / necessary validation from GM, DIC.",
          "source_url": "https://www.myscheme.gov.in/schemes/cmegp",
          "source_path": "en.applicationProcess[0].process[0].children[12]",
          "channel": "Online",
          "heading": null
        }
      ]
    },
