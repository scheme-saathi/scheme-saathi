    "eligibility": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The applicant should be a citizen of India.",
          "source_url": "https://www.myscheme.gov.in/schemes/spmsd",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should be a domicile / permanent resident of the state of Maharashtra.",
          "source_url": "https://www.myscheme.gov.in/schemes/spmsd",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should be a student admitted/enrolled in a school recognized by the Govt. of Maharashtra.",
          "source_url": "https://www.myscheme.gov.in/schemes/spmsd",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should be a Person with Disability (Visually Handicapped, Low Vision, Hearing Impaired, Orthopedically Handicapped, etc).",
          "source_url": "https://www.myscheme.gov.in/schemes/spmsd",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The percentage of the disability should be 40% or above.",
          "source_url": "https://www.myscheme.gov.in/schemes/spmsd",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[4]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should have passed class 10th.",
          "source_url": "https://www.myscheme.gov.in/schemes/spmsd",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[5]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should not have failed in the last qualifying examination.",
          "source_url": "https://www.myscheme.gov.in/schemes/spmsd",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[6]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should be pursuing a post-metric qualification, i.e. Higher Secondary School (Class 11th, Class 12th), or a Technical/Professional Degree in Medical, Engineering, etc.",
          "source_url": "https://www.myscheme.gov.in/schemes/spmsd",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[7]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "exclusions": {
