{
  "scheme_id": "C16",
  "slug": "dacssiselosobcebc",
  "name": "Dr Ambedkar Central Sector Scheme of Interest Subsidy on Educational Loans for Overseas Studies for Other Backward Classes (OBCs) and Economically Backward Classes (EBCs)",
  "government_level": "Central",
  "geography": "India",
  "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
  "collected_on": "2026-10-28",
  "review_status": "approved",
  "availability_status": "open",
  "sample_only": false,
  "sections": {
    "details": {
      "capture_status": "captured",
      "items": [
        {
          "text": "\"Dr Ambedkar Central Sector Scheme of Interest Subsidy on Educational Loans for Overseas Studies for Other Backward Classes (OBCs) and Economically Backward Classes (EBCs)\" is an Education Loan Scheme by the Department of Social Justice and Empowerment, Ministry of Social Justice and Empowerment.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.schemeContent.detailedDescription[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Implementing Agency",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.schemeContent.detailedDescription[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The Scheme will be implemented by the Nodal Bank as per the MoU between the Banks and the Ministry of Social Justice & Empowerment.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.schemeContent.detailedDescription[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Scope",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.schemeContent.detailedDescription[5]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The scheme provides interest subsidy to the students belonging to the OBCs and EBCs on the interest payable for the period of the moratorium for the Education Loans for overseas studies to pursue approved courses of studies abroad at Masters, M.Phil. and PhD level.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.schemeContent.detailedDescription[6]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Objective",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.schemeContent.detailedDescription[8]",
          "channel": null,
          "heading": null
        },
        {
          "text": "To award interest subsidies to meritorious students belonging to the Other Backward Classes and Economically Backward Classes to provide them with better opportunities for higher education abroad and enhance their employability.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.schemeContent.detailedDescription[9]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "benefits": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Under the scheme, interest payable by the students availing the education loans of the IBA for the period of moratorium (i.e. course period, plus one year or six months after getting a job, whichever is earlier) as prescribed under the Education Loan Scheme of the IBA, shall be borne by the Government of India.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.schemeContent.benefits[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "For a student, the eligible loan component shall be the actual loan taken subject to a maximum of ₹ 20,00,000 for the purpose of an Interest subsidy claim.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.schemeContent.benefits[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "NOTE 1: After the period of moratorium is over, the interest on the outstanding loan amount shall be paid by the student, in accordance with the existing Educational Loan Scheme as may be amended from time to time.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.schemeContent.benefits[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "NOTE 2: The candidate will bear the Principal instalments and interest beyond the moratorium period.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.schemeContent.benefits[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Release of Funds",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.schemeContent.benefits[4].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The funds will be released to the applicants on a first-come-first-served basis, subject to a maximum amount to be worked out every year based on the total budget made available that year, under the scheme.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.schemeContent.benefits[5]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "eligibility": {
      "capture_status": "captured",
      "items": [
        {
          "text": "The applicant should be a Student.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The student should have secured admission in the approved course at Masters, M.Phil or PhD levels abroad for the listed courses.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[1]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The applicant should have availed loan from a scheduled bank under the Education Loan Scheme of the Indian Banks Association (IBA) for the purpose.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[2]",
          "channel": null,
          "heading": null
        },
        {
          "text": "The total income of the applicant (from all sources) shall not exceed ₹ 8,00,000 per annum.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[0].children[3]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Reservation/ Relaxation/ Preference/ Priority",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[2].children[0]",
          "channel": null,
          "heading": null
        },
        {
          "text": "Out of the total outlay in a year, a minimum of 50% amount will be earmarked for Interest Subsidy to the girl candidates.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.eligibilityCriteria.eligibilityDescription[3]",
          "channel": null,
          "heading": null
        }
      ]
    },
    "exclusions": {
      "capture_status": "not_in_source",
      "items": []
    },
    "application_process": {
      "capture_status": "captured",
      "items": [
        {
          "text": "Step 1: The interest Subsidy shall be linked with the existing Educational Loan Scheme of the Indian Banks Association (IBA) and restricted to students enrolled for courses at Master, M.Phil and PhD levels.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.applicationProcess[0].process[0]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "Step 2: The Nodal Bank will lay down the detailed procedure for processing and sanctioning interest subsidies to eligible students in consultation with the Ministry.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.applicationProcess[0].process[1]",
          "channel": "Offline",
          "heading": null
        },
        {
          "text": "Step 3: The Recommendatory Committee headed by the Joint Secretary in charge of the Backward Classes Division with representatives of the Finance Division, a representative of Nodal Bank and the concerned Director/Deputy Secretary as convener will examine and recommend the applications for the award of interest subsidy on a quarterly basis.",
          "source_url": "https://www.myscheme.gov.in/schemes/dacssiselosobcebc",
          "source_path": "en.applicationProcess[0].process[2]",
          "channel": "Offline",
          "heading": null
        }
      ]
    },
