        "type": "prometheus",
        "uid": "scheme-saathi-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheme-saathi-prometheus"
          },
          "expr": "sum(increase(scheme_saathi_eligibility_verdicts_total{verdict=\"cant_tell\"}[$__range])) / sum(increase(scheme_saathi_eligibility_verdicts_total[$__range]))",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
