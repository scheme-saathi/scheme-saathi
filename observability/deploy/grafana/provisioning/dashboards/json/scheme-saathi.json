    {
      "type": "stat",
      "title": "Questions per conversation",
      "description": "Intake questions asked (chat turns, and fact-confirmation edits that reopen intake, ending needs_information) divided by conversations started, in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "scheme-saathi-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheme-saathi-prometheus"
          },
          "expr": "sum(increase(scheme_saathi_runs_total{kind=~\"chat_turn|chat_decision\",outcome=\"needs_information\"}[$__range])) / sum(increase(scheme_saathi_conversations_started_total[$__range]))",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
