OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
SUPERVISOR_MODEL=
ROUTER_MODEL=
SPECIALIST_MODEL=
JUDGE_MODEL=
# Evaluation only: the simulated citizen; must be a different model family from the agents
CITIZEN_MODEL=
SCHEME_SAATHI_DOCUMENT_STORE_DIR=
SCHEME_SAATHI_MEMORY_DIR=
SCHEME_SAATHI_CHECKPOINT_DB=
MOCK_PORTAL_AUTH_SECRET=
MOCK_PORTAL_NONCE_DB=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_REDIRECT_URI=
AUTH0_HOUSEHOLD_CLAIM=
AUTH0_ROLE_CLAIM=
# Observability (off unless OBSERVABILITY_ENABLED=true). /metrics needs METRICS_BEARER_TOKEN.
OBSERVABILITY_ENABLED=
METRICS_BEARER_TOKEN=
# Optional path to a model price file (see observability/model_prices.json) for models whose provider reports no cost.
MODEL_PRICES_FILE=
# Tracing (needs OBSERVABILITY_ENABLED=true): TRACING_BACKEND is empty/none or langsmith.
# Traces carry metadata only. Leave LANGSMITH_TRACING and LANGCHAIN_TRACING_V2 unset: they would send prompts.
TRACING_BACKEND=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
# Share of runs traced, 0 to 1 (failed runs are always traced). Salt for hashing conversation IDs; random per start if empty.
TRACING_SAMPLE_RATE=
TRACING_HASH_SALT=